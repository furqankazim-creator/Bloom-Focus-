{
  "expo": {
    "name": "Bloom Focus",
    "slug": "bloom-focus",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloomfocus.app"
    },
    "android": {
      "package": "com.bloomfocus.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F5D46"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloom Focus uses your photos so you can set your child's profile picture and share photos or screenshots in private messages.",
          "cameraPermission": "Bloom Focus uses the camera so you can take your child's profile picture or a photo for a private message."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bloom Focus uses the microphone so you can record voice notes in private messages."
        }
      ],
      "expo-asset",
      "expo-splash-screen"
    ]
  }
}
